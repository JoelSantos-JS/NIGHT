{
  "name": "night",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Night: assistente pessoal local, voz primeiro, que delega tarefas ao Claude Code e ao Codex",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "night": "node --disable-warning=ExperimentalWarning --import tsx src/app/cli.ts",
    "seed": "node --import tsx scripts/seed-projects.ts",
    "night:servidor": "node --disable-warning=ExperimentalWarning --import tsx src/app/server-main.ts",
    "night:telas": "node --import tsx scripts/openbot-telas.ts",
    "night:voz": "node --disable-warning=ExperimentalWarning --import tsx src/app/voice.ts",
    "test:voz": "node --import tsx --test \"tests/voice/**/*.test.ts\"",
    "night:teste": "node --disable-warning=ExperimentalWarning --import tsx src/app/voice-test.ts",
    "e2e:agentes": "node --disable-warning=ExperimentalWarning --import tsx scripts/e2e-agents.ts",
    "night:calibrar": "node --disable-warning=ExperimentalWarning --import tsx src/app/calibrate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "playwright-core": "1.65.1"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
