{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Video Storyboard v1",
  "type":"object",
  "required":["job_id","title","language","style","duration_seconds","fps","width","height","scenes"],
  "properties":{
    "job_id":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":1},
    "language":{"type":"string"},
    "style":{"enum":["stickman-2d","motion-graphics","3d-stylized"]},
    "duration_seconds":{"type":"number","exclusiveMinimum":0,"maximum":180},
    "fps":{"type":"integer","minimum":24,"maximum":60},
    "width":{"type":"integer","minimum":720},
    "height":{"type":"integer","minimum":1280},
    "scenes":{"type":"array","minItems":1,"items":{
      "type":"object","required":["id","start_seconds","end_seconds","visual","action","voiceover","onscreen_text"],
      "properties":{
        "id":{"type":"string"},"start_seconds":{"type":"number","minimum":0},"end_seconds":{"type":"number","exclusiveMinimum":0},
        "visual":{"type":"string"},"action":{"type":"string"},"voiceover":{"type":"string"},"onscreen_text":{"type":"string"},
        "assets":{"type":"array","items":{"type":"string"}},"transition":{"type":"string"}
      },"additionalProperties":true
    }}
  },"additionalProperties":true
}
